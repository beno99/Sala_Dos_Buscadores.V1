DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

S3_ENDPOINT=https://SEU_PROJETO.storage.supabase.co/storage/v1/s3
S3_REGIAO=sa-east-1
S3_BUCKET=sala-midia
S3_CHAVE=SUA_ACCESS_KEY_ID
S3_SEGREDO=SEU_SECRET_ACCESS_KEY

SEED_ADMIN_EMAIL=curadoria@saladosbuscadores.org
SEED_ADMIN_SENHA=TROQUE_POR_UMA_SENHA_FORTE

SDB_URL_PUBLICA=http://localhost:3000

# E-mail de verificação de conta (Resend, instalado pelo Vercel Marketplace:
# `vercel integration add resend -m domain=SEU_DOMINIO -m region=sa-east-1`,
# depois `vercel env pull`). RESEND_API_KEY e RESEND_EMAIL_DOMAIN vêm de lá.
# Sem RESEND_API_KEY, o envio só fica registrado em /admin/caixa-saida (dev local).
RESEND_API_KEY=SUA_CHAVE_DO_RESEND
RESEND_EMAIL_DOMAIN=SEU_DOMINIO
# Opcional: só se quiser um remetente diferente de verificacao@RESEND_EMAIL_DOMAIN.
SDB_EMAIL_REMETENTE=A Sala dos Buscadores <verificacao@SEU_DOMINIO>

GEMINI_API_KEY=SUA_CHAVE_DO_GOOGLE_AI_STUDIO
