{
  "name": "sala-dos-buscadores-portal",
  "version": "0.1.0",
  "private": true,
  "description": "MVP de A Sala dos Buscadores: acervo em Salas, busca comparativa e assistente de IA, com Postgres e armazenamento S3.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "npm run ds:sync",
    "dev": "next dev",
    "prebuild": "npm run ds:check",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local --conditions=react-server scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "ds:sync": "node scripts/sync-design-system.mjs",
    "ds:check": "node scripts/sync-design-system.mjs --check",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run ds:check && npm run ds:test && npm run lint && npm run typecheck",
    "ds:test": "node --test ../design-system/components/BarraFormatacao/marcacao.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.7",
    "next": "16.3.6",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
